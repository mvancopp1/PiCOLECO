	DB $44
	; DATA BYTE $44,$44,$44,$44,$44,$44,$44,$44
	DB $44
	DB $44
	DB $44
	DB $44
	DB $44
	DB $44
	DB $44
	DB $44
	; DATA BYTE $44,$44,$44,$44,$44,$44,$44,$44
	DB $44
	DB $44
	DB $44
	DB $44
	DB $44
	DB $44
	DB $44
	DB $44
	; DATA BYTE $44,$44,$44,$44,$44,$44,$44,$44
	DB $44
	DB $44
	DB $44
	DB $44
	DB $44
	DB $44
	DB $44
	DB $44
	; DATA BYTE $44,$44,$44,$44,$44,$44,$44,$44
	DB $44
	DB $44
	DB $44
	DB $44
	DB $44
	DB $44
	DB $44
	DB $44
	; DATA BYTE $44,$44,$44,$44,$44,$44,$44,$44
	DB $44
	DB $44
