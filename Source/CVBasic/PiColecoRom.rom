	;     SOUND 1,(#C+1)/2,5
	LD HL,(cvb_#C)
	INC HL
	SRL H
	RR L
	LD A,$a0
	CALL sn76489_freq
	LD A,5
	LD B,$b0
	CALL sn76489_vol
	;     SOUND 2,#C*2,8
	LD HL,(cvb_#C)
