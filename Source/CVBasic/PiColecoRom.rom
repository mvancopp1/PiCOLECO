	DB $6c
cv26:
	;    print at 32*23+12,"Btn2->Dir-Up"
	LD HL,748
	LD (cursor),HL
	LD HL,cv27
	LD A,12
	CALL print_string
	JP cv28
cv27:
	DB $42,$74,$6e,$32,$2d,$3e,$44,$69
	DB $72,$2d,$55,$70
cv28:
	; 
	;   ' nf=peek(6130)
	;   ' print at 32*23+1,"ROMS from:"
	;   ' print at 32*23+11,nf
	;   ' nf=peek(6131)
	;   ' print at 32*23+15,"to:"
	;   ' print at 32*23+18,nf
	;   ' nf=peek(6132)
	;   ' print at 32*23+22,"of:"
	;   ' print at 32*23+25,nf
	; 
	; getinput:
cvb_GETINPUT:
	;   c=cont
	LD A,(joy2_data)
	PUSH AF
	LD A,(joy1_data)
	POP BC
	OR B
	LD (cvb_C),A
	;   while c=0
cv29:
	LD A,(cvb_C)
	AND A
	JP NZ,cv30
	; 	wait 
	HALT
	; 	c=cont  
	LD A,(joy2_data)
	PUSH AF
	LD A,(joy1_data)
	POP BC
	OR B
	LD (cvb_C),A
	;     'print at 32*23+20,c 
	;  WEND
	JP cv29
cv30:
	;   sound 0,120,5
	LD HL,120
	LD A,$80
	CALL sn76489_freq
	LD A,5
	LD B,$90
	CALL sn76489_vol
	;   WAIT
	HALT
	;   sound 0,0,0 
	LD HL,0
	LD A,$80
	CALL sn76489_freq
	SUB A
	LD B,$90
	CALL sn76489_vol
	;   
	;    if (c=cont.button2) then goto updir
	LD A,(joy2_data)
	PUSH AF
	LD A,(joy1_data)
	POP BC
	OR B
	AND 128
	PUSH AF
	LD A,(cvb_C)
	POP BC
	CP B
	JP NZ,cv31
	JP cvb_UPDIR
cv31:
	;    if (c=cont.button) then goto rungame
	LD A,(joy2_data)
	PUSH AF
	LD A,(joy1_data)
	POP BC
	OR B
	AND 64
	PUSH AF
	LD A,(cvb_C)
	POP BC
	CP B
	JP NZ,cv32
	JP cvb_RUNGAME
cv32:
	;    if (c=cont.left)  THEN goto prevpage
	LD A,(joy2_data)
	PUSH AF
	LD A,(joy1_data)
	POP BC
	OR B
	AND 8
	PUSH AF
	LD A,(cvb_C)
	POP BC
	CP B
	JP NZ,cv33
	JP cvb_PREVPAGE
cv33:
	;    if (c=cont.down) and (numfile<totfile) THEN numfileold=numfile:numfile=numfile+1:goto scegli
	LD A,(cvb_TOTFILE)
	PUSH AF
	LD A,(cvb_NUMFILE)
	POP BC
	CP B
	LD A,0
	JR NC,$+3
	DEC A
	PUSH AF
	LD A,(joy2_data)
	PUSH AF
	LD A,(joy1_data)
	POP BC
	OR B
	AND 4
	PUSH AF
	LD A,(cvb_C)
	POP BC
	CP B
	LD A,0
	JR NZ,$+3
	DEC A
	POP BC
	AND B
	JP Z,cv34
	LD A,(cvb_NUMFILE)
	LD (cvb_NUMFILEOLD),A
	LD A,(cvb_NUMFILE)
	INC A
	LD (cvb_NUMFILE),A
	JP cvb_SCEGLI
cv34:
	;    if (c=cont.right)  THEN goto nextpage
	LD A,(joy2_data)
	PUSH AF
	LD A,(joy1_data)
	POP BC
	OR B
	AND 2
	PUSH AF
	LD A,(cvb_C)
	POP BC
	CP B
	JP NZ,cv35
	JP cvb_NEXTPAGE
cv35:
	;    if (c=cont.up) and (numfile>1) THEN numfileold=numfile:numfile=numfile-1:goto scegli
	LD A,(cvb_NUMFILE)
	PUSH AF
	LD A,1
	POP BC
	CP B
	LD A,0
	JR NC,$+3
	DEC A
	PUSH AF
	LD A,(joy2_data)
	PUSH AF
	LD A,(joy1_data)
	POP BC
	OR B
	AND 1
	PUSH AF
	LD A,(cvb_C)
	POP BC
	CP B
	LD A,0
	JR NZ,$+3
	DEC A
	POP BC
	AND B
	JP Z,cv36
	LD A,(cvb_NUMFILE)
	LD (cvb_NUMFILEOLD),A
	LD A,(cvb_NUMFILE)
	DEC A
	LD (cvb_NUMFILE),A
	JP cvb_SCEGLI
cv36:
	; 
	;    c=0
	SUB A
	LD (cvb_C),A
	;    goto getinput
	JP cvb_GETINPUT
	;     
	; nextpage:
cvb_NEXTPAGE:
	;    poke $8000+5999,0 ' wait for goto
	LD HL,38767
	PUSH HL
	SUB A
	POP HL
	LD (HL),A
	;    poke $f003,3 ' next page
	LD HL,61443
	PUSH HL
	LD A,3
	POP HL
	LD (HL),A
	;    print at 32*23,"--> Next DIR"
	LD HL,736
	LD (cursor),HL
	LD HL,cv37
	LD A,12
	CALL print_string
	JP cv38
cv37:
	DB $2d,$2d,$3e,$20,$4e,$65,$78,$74
	DB $20,$44,$49,$52
cv38:
	;    for i=0 to 40:wait:next i
	SUB A
	LD (cvb_I),A
cv39:
	HALT
	LD A,(cvb_I)
	INC A
	LD (cvb_I),A
	PUSH AF
	LD A,40
	POP BC
	CP B
	LD A,0
	JR NC,$+3
	DEC A
	OR A
	JP Z,cv39
	;    while peek($8000+5999)<>1:wend
cv40:
	LD HL,38767
	LD A,(HL)
	CP 1
	JP Z,cv41
	JP cv40
cv41:
	;  
	;    goto newdir
	JP cvb_NEWDIR
	;    
	; prevpage:
cvb_PREVPAGE:
	;    poke $f004,4 ' prev page
	LD HL,61444
	PUSH HL
	LD A,4
	POP HL
	LD (HL),A
	;    print at 32*23,"--> Prev DIR"
	LD HL,736
	LD (cursor),HL
	LD HL,cv42
	LD A,12
	CALL print_string
	JP cv43
cv42:
	DB $2d,$2d,$3e,$20,$50,$72,$65,$76
	DB $20,$44,$49,$52
cv43:
	;    for i=0 to 40:wait:next i
	SUB A
	LD (cvb_I),A
cv44:
	HALT
	LD A,(cvb_I)
	INC A
	LD (cvb_I),A
	PUSH AF
	LD A,40
	POP BC
	CP B
	LD A,0
	JR NC,$+3
	DEC A
	OR A
	JP Z,cv44
	;    while peek($8000+5999)<>1:wend
cv45:
	LD HL,38767
	LD A,(HL)
	CP 1
	JP Z,cv46
	JP cv45
cv46:
	;    
	;    goto newdir
	JP cvb_NEWDIR
	;   
	; updir:
cvb_UPDIR:
	;    poke $f005,5 ' up Dir
	LD HL,61445
	PUSH HL
	LD A,5
	POP HL
	LD (HL),A
	;    print at 32*23,"--> Up DIR"
	LD HL,736
	LD (cursor),HL
	LD HL,cv47
	LD A,10
	CALL print_string
	JP cv48
cv47:
	DB $2d,$2d,$3e,$20,$55,$70,$20,$44
	DB $49,$52
cv48:
	;    for i=0 to 40:wait:next i
	SUB A
	LD (cvb_I),A
cv49:
	HALT
	LD A,(cvb_I)
	INC A
	LD (cvb_I),A
	PUSH AF
	LD A,40
	POP BC
	CP B
	LD A,0
	JR NC,$+3
	DEC A
	OR A
	JP Z,cv49
	;    while peek($8000+5999)<>1:wend
cv50:
	LD HL,38767
	LD A,(HL)
	CP 1
	JP Z,cv51
	JP cv50
cv51:
	;    goto newdir
	JP cvb_NEWDIR
	; 
	; rungame:  
cvb_RUNGAME:
	;   CLS  
	CALL cls
	;   poke $f100+numfile,numfile ' file to run
	LD A,(cvb_NUMFILE)
	LD L,A
	LD H,0
	LD DE,61696
	ADD HL,DE
	PUSH HL
	POP HL
	LD (HL),A
	;   poke $f002,2 ' run file
	LD HL,61442
	PUSH HL
	LD A,2
	POP HL
	LD (HL),A
	;   if peek($8000+7100+numfile-1)=1 then  ' is opendir
	LD A,(cvb_NUMFILE)
	LD L,A
	LD H,0
	LD DE,39867
	ADD HL,DE
	LD A,(HL)
	CP 1
	JP NZ,cv52
	;   print at 32*23,"--> Open DIR"
	LD HL,736
	LD (cursor),HL
	LD HL,cv53
	LD A,12
	CALL print_string
	JP cv54
cv53:
	DB $2d,$2d,$3e,$20,$4f,$70,$65,$6e
	DB $20,$44,$49,$52
cv54:
	;   for i=0 to 40:wait:next i
	SUB A
	LD (cvb_I),A
cv55:
	HALT
	LD A,(cvb_I)
	INC A
	LD (cvb_I),A
	PUSH AF
	LD A,40
	POP BC
	CP B
	LD A,0
	JR NC,$+3
	DEC A
	OR A
	JP Z,cv55
	;   while peek($8000+5999)<>1:wend
cv56:
	LD HL,38767
	LD A,(HL)
	CP 1
	JP Z,cv57
	JP cv56
cv57:
	;   goto newdir
	JP cvb_NEWDIR
	;   end IF
cv52:
	;   ' else is run game
	;   
	;   print at 32*4,"Loading ROM:"
	LD HL,128
	LD (cursor),HL
	LD HL,cv58
	LD A,12
	CALL print_string
	JP cv59
cv58:
	DB $4c,$6f,$61,$64,$69,$6e,$67,$20
	DB $52,$4f,$4d,$3a
cv59:
	;   for i=0 to 255
	SUB A
	LD (cvb_I),A
cv60:
	; 	vpoke $1800+32*5+i, peek($8000+6002+i)
	LD A,(cvb_I)
	LD L,A
	LD H,0
	LD DE,6304
	ADD HL,DE
	PUSH HL
	LD L,A
	LD H,0
	LD DE,38770
	ADD HL,DE
	LD A,(HL)
	POP HL
	CALL NMI_OFF
	CALL WRTVRM
	CALL NMI_ON
	;   next i
	LD A,(cvb_I)
	INC A
	LD (cvb_I),A
	PUSH AF
	LD A,255
	POP BC
	CP B
	LD A,0
	JR NC,$+3
	DEC A
	OR A
	JP Z,cv60
	;   for i=1 to 32
	LD A,1
	LD (cvb_I),A
cv61:
	;   border i
	LD A,(cvb_I)
	LD B,A
	LD C,7
	CALL nmi_off
	CALL WRTVDP
	CALL nmi_on
	;   wait
	HALT
	;   next i
	LD A,(cvb_I)
	INC A
	LD (cvb_I),A
	PUSH AF
	LD A,32
	POP BC
	CP B
	LD A,0
	JR NC,$+3
	DEC A
	OR A
	JP Z,cv61
	;   
	;    for i=0 to 5
	SUB A
	LD (cvb_I),A
cv62:
	; 	 border i
	LD A,(cvb_I)
	LD B,A
	LD C,7
	CALL nmi_off
	CALL WRTVDP
	CALL nmi_on
	; 	 wait
	HALT
	;    next i
	LD A,(cvb_I)
	INC A
	LD (cvb_I),A
	PUSH AF
	LD A,5
	POP BC
	CP B
	LD A,0
	JR NC,$+3
	DEC A
	OR A
	JP Z,cv62
	;  
	;     cls
	CALL cls
	; 
	;    WHILE 1:WEND
cv63:
	JP cv63
cv64:
	;    
	; reset_sound:    PROCEDURE
cvb_RESET_SOUND:
	;       SOUND 0,,0
	SUB A
	LD B,$90
	CALL sn76489_vol
	;       SOUND 1,,0
	SUB A
	LD B,$b0
	CALL sn76489_vol
	;       SOUND 2,,0
	SUB A
	LD B,$d0
	CALL sn76489_vol
	;       SOUND 3,,0
	SUB A
	LD B,$f0
	CALL sn76489_vol
	;     RETURN
	RET
	;     END
	RET
	; 
	; saved_string:
cvb_SAVED_STRING:
	; 	DATA BYTE "Test string",0
	DB $54,$65,$73,$74,$20,$73,$74,$72
	DB $69,$6e,$67
	DB $00
	; 
	;     include "cv_logo.bas"
	; 	' TMSColor 2.2.1 Mar/29/2024
	; 	' Command: C:\Users\Andrea\Documents\Retrocomputer\Colecovision\CVBasic\tmscolor.exe -b -p1 -z cv_logo.bmp cv_logo.bas 
	; 	' Created: Thu May 16 16:18:57 2024
	; 
	; 	MODE 1
	CALL mode_1
	; 	SCREEN DISABLE
	CALL DISSCR
	; 	DEFINE VRAM PLETTER $0000,$1800,image_bitmap
	LD HL,0
	PUSH HL
	LD HL,6144
	PUSH HL
	LD HL,cvb_IMAGE_BITMAP
	POP BC
	POP DE
	CALL unpack
	; 	DEFINE VRAM PLETTER $2000,$1800,image_color
	LD HL,8192
	PUSH HL
	LD HL,6144
	PUSH HL
	LD HL,cvb_IMAGE_COLOR
	POP BC
	POP DE
	CALL unpack
	; 	SCREEN ENABLE
	CALL ENASCR
	; 	WHILE 1: WEND
cv65:
	JP cv65
cv66:
	; 
